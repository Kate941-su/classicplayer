# ストアの既定の掲載情報（文面・スクリーンショット・アイコン・フィーチャーグラフィック）を送る。
# アプリ本体（AAB / IPA）は送らない。画像の作り直しは tool/store_screenshots.sh（fastlane/STORE_LISTING.md）。
#
#   fastlane ios metadata       # App Store Connect に送る（審査には出さない）
#   fastlane android metadata   # Google Play に送る
#   fastlane ios beta           # Archive → App Store 用に書き出し → TestFlight に上げる（審査には出さない）
#   fastlane ios check_auth / fastlane android check_auth   # 鍵が使えるかだけ確かめる（何も変えない）
#
# 鍵はリポジトリに入れない。fastlane/.env（.gitignore 済み。ひな形は fastlane/.env.example）で渡す:
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH（App Store Connect API キーの .p8）
#   SUPPLY_JSON_KEY（Google Play のサービスアカウントの JSON）

opt_out_usage # 利用状況を fastlane に送らない

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
    in_house: false
  )
end

platform :ios do
  desc "App Store の掲載情報とスクリーンショットを送る（審査には出さない）"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      metadata_path: "./fastlane/metadata/ios",
      screenshots_path: "./fastlane/screenshots/ios",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: true,
      submit_for_review: false,
      force: true, # HTML のプレビューを出さない
      run_precheck_before_submit: false
    )
  end

  desc "Archive して App Store 用に書き出し（本番用の署名は自動署名が付ける）、TestFlight に上げる（審査には出さない）"
  lane :beta do
    api_key = asc_api_key
    # ビルド番号は TestFlight の最新 + 1（project.yml の CURRENT_PROJECT_VERSION はそのまま）
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    root = File.expand_path("..", __dir__)
    key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    xcargs = [
      # API キーで証明書とプロファイルを作る・取る（Xcode にアカウントを入れていなくても動く）
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path.shellescape}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      # 同梱カタログは公開中のカタログ（SPEC §2・§6。既定のフィクスチャは 20 曲だけ）
      "CMSL_SEED_CATALOG=#{File.join(root, 'site/v1/catalog.json').shellescape}"
    ].join(" ")
    ipa = build_app(
      project: "ios/CMSLClassical.xcodeproj",
      scheme: "CMSLClassical",
      configuration: "Release",
      export_method: "app-store",
      export_options: { signingStyle: "automatic", teamID: "WATT786F4L" },
      xcargs: xcargs,
      output_directory: "build/ios",
      output_name: "CMSLClassical-#{build_number}.ipa",
      clean: true
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true, # 処理の完了（数十分）は待たない
      skip_submission: true
    )
    UI.success("TestFlight に上げました: ビルド #{build_number}")
  end

  desc "App Store Connect の API キーが使えるか確かめる（アプリの情報を読むだけ）"
  lane :check_auth do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App Store Connect に jp.vntech.classic のアプリがありません。先に「新規 App」で作ってください") unless app
    UI.success("OK: #{app.name}（#{app.bundle_id}）")
  end
end

platform :android do
  desc "Google Play の掲載情報と画像を送る"
  lane :metadata do
    supply(
      json_key: File.expand_path(ENV.fetch("SUPPLY_JSON_KEY")),
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true
    )
  end

  desc "Google Play のサービスアカウントの鍵が使えるか確かめる（何も変えない）"
  lane :check_auth do
    validate_play_store_json_key(json_key: File.expand_path(ENV.fetch("SUPPLY_JSON_KEY")))
  end
end
