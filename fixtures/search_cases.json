  "queries": [
    { "query": "ベートーベン", "expect": { "composers": ["l-v-beethoven"], "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴--2020-ar", "l-v-beethoven--交響曲第5番ハ短調op-67-運命--2015"], "tracks": ["474143449", "427916377"] }, "first": { "composers": "l-v-beethoven" } },
    { "query": "beethoven", "expect": { "composers": ["l-v-beethoven"], "tracks": ["474143449"] }, "first": { "composers": "l-v-beethoven" } },
    { "query": "べーとーゔぇん", "expect": { "composers": ["l-v-beethoven"] } },
    { "query": "ＢＥＥＴＨＯＶＥＮ", "expect": { "composers": ["l-v-beethoven"] } },
    { "query": "しょぱん", "expect": { "composers": ["frederic-francois-chopin"], "works": ["frederic-francois-chopin--ノクターン第2番変ホ長調op-9-2"], "tracks": ["211280853"] }, "absent": { "composers": ["l-v-beethoven"] } },
    { "query": "chopin", "expect": { "composers": ["frederic-francois-chopin"] } },
    { "query": "dvorak", "expect": { "composers": ["antonín-dvořák"], "tracks": ["467532689"] }, "first": { "composers": "antonín-dvořák" } },
    { "query": "ドボルザーク", "expect": { "composers": ["antonín-dvořák"], "works": ["antonín-dvořák--交響曲第9番ホ短調op-95-新世界より--2019-ar"] } },
    { "query": "alhambra", "expect": { "tracks": ["474475833"] }, "absent": { "composers": ["francisco-tarrega"] } },
    { "query": "悲愴", "expect": { "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴--2020-ar"], "tracks": ["474143449"] }, "absent": { "works": ["l-v-beethoven--交響曲第5番ハ短調op-67-運命--2015"] } },
    { "query": "ベートーベン　運命", "expect": { "works": ["l-v-beethoven--交響曲第5番ハ短調op-67-運命--2015", "l-v-beethoven--交響曲第5番ハ短調op-67-運命--2023"], "tracks": ["427916377", "500111088-0", "500150417"] }, "absent": { "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴--2020-ar"], "tracks": ["474143449"] } },
    { "query": "op.13", "expect": { "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴--2020-ar"] } },
    { "query": "ブラームス 第2楽章", "expect": { "tracks": ["476156249-1"] }, "absent": { "tracks": ["476156249-0"] } },
    { "query": "パヴァーヌ", "expect": { "works": ["gabriel-urbain-faure--パヴァーヌop-50--2020-ir"], "tracks": ["476156249-4"] } },
