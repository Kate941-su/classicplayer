{
  "$comment": "検索の正規化と照合のテストケース（docs/search-normalization.md）。queries は fixtures/catalog.sample.json（実カタログから抜き出した 20 曲。PLAN 0.9）に対して実行する。expect は「含むべき ID」、absent は「含んではいけない ID」、empty は「全セクションが空」",
  "normalize": [
    { "input": "ベートーベン", "expected": "ベトベン" },
    { "input": "ベートーヴェン", "expected": "ベトベン" },
    { "input": "べーとーゔぇん", "expected": "ベトベン" },
    { "input": "ﾍﾞｰﾄｰｳﾞｪﾝ", "expected": "ベトベン" },
    { "input": "ＢＥＥＴＨＯＶＥＮ", "expected": "beethoven" },
    { "input": "L.V.Beethoven", "expected": "lvbeethoven" },
    { "input": "しょぱん", "expected": "ショパン" },
    { "input": "Dvořák", "expected": "dvorak" },
    { "input": "ドヴォルザーク", "expected": "ドボルザク" },
    { "input": "ヴィヴァルディ", "expected": "ビバルディ" },
    { "input": "グリーン スリーブス", "expected": "グリンスリブス" },
    { "input": "ピアノソナタ 第８番 ハ短調 Op.13 「悲愴」", "expected": "ピアノソナタ第8番ハ短調op13悲愴" },
    { "input": "Op.9-2", "expected": "op92" },
    { "input": "　全角　空白　", "expected": "全角空白" },
    { "input": "Café", "expected": "cafe" }
  ],
  "queries": [
    { "query": "ベートーベン", "expect": { "composers": ["l-v-beethoven"], "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴", "l-v-beethoven--交響曲第5番ハ短調op-67-運命"], "tracks": ["474143449", "500111088-0"] }, "first": { "composers": "l-v-beethoven" } },
    { "query": "beethoven", "expect": { "composers": ["l-v-beethoven"], "tracks": ["474143449"] }, "first": { "composers": "l-v-beethoven" } },
    { "query": "べーとーゔぇん", "expect": { "composers": ["l-v-beethoven"] } },
    { "query": "ＢＥＥＴＨＯＶＥＮ", "expect": { "composers": ["l-v-beethoven"] } },
    { "query": "しょぱん", "expect": { "composers": ["frederic-francois-chopin"], "works": ["frederic-francois-chopin--ノクターン第2番変ホ長調op-9-2"], "tracks": ["314008303"] }, "absent": { "composers": ["l-v-beethoven"] } },
    { "query": "chopin", "expect": { "composers": ["frederic-francois-chopin"] } },
    { "query": "dvorak", "expect": { "composers": ["antonín-dvořák"], "tracks": ["499579424-0"] }, "first": { "composers": "antonín-dvořák" } },
    { "query": "ドボルザーク", "expect": { "composers": ["antonín-dvořák"], "works": ["antonín-dvořák--交響曲第9番ホ短調op-95-新世界より"] } },
    { "query": "alhambra", "expect": { "tracks": ["474475833"] }, "absent": { "composers": ["francisco-tarrega"] } },
    { "query": "悲愴", "expect": { "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴"], "tracks": ["474143449"] }, "absent": { "works": ["l-v-beethoven--交響曲第5番ハ短調op-67-運命"] } },
    { "query": "ベートーベン　運命", "expect": { "works": ["l-v-beethoven--交響曲第5番ハ短調op-67-運命"], "tracks": ["500111088-0", "500150417"] }, "absent": { "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴"], "tracks": ["474143449"] } },
    { "query": "op.13", "expect": { "works": ["l-v-beethoven--ピアノソナタ第8番ハ短調op-13-悲愴"] } },
    { "query": "ブラームス 第2楽章", "expect": { "tracks": ["476156249-1"] }, "absent": { "tracks": ["499179250"] } },
    { "query": "別れの曲", "expect": { "works": ["frederic-francois-chopin--エチュードop-10-3ホ長調-別れの曲"], "tracks": ["476991508-3"] } },
    { "query": "アメイジング グレイス", "expect": { "works": ["john-newton--アメイジング-グレイス"], "tracks": ["174220792"] } },
    { "query": "モーツァルト", "empty": true },
    { "query": "  ー・ ", "empty": true }
  ]
}
