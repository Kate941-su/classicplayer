    "info.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not collect any data. There are no ads, analytics or accounts. Favorites and history are stored only on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはデータを収集しません。広告・解析・アカウントはありません。お気に入りと履歴はこの端末の中だけに保存されます。"
          }
        }
      }
    },
    "info.privacyPolicy": {
