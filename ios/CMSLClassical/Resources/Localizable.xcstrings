    "info.termsBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recordings are free material published by CMSL and are used under the Creative Commons Attribution 2.1 Japan license. This app does not host the audio files; it plays them from the CMSL server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音源は CMSL が公開しているフリー素材で、クリエイティブ・コモンズ 表示 2.1 日本 ライセンスのもとで利用しています。このアプリは音源ファイルを再配布せず、CMSL のサーバーから直接再生します。"
          }
        }
      }
    },
