    "info.aboutBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet, ad-free player for classical music only. Browse the free recordings of the CMSL Classical Masterpieces Sound Library by genre, composer and work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告なしで、クラシックだけを、静かに聴けるプレイヤーです。CMSL クラシック名曲サウンドライブラリーのフリー音源を、ジャンル・作曲家・作品から探して再生できます。"
          }
        }
      }
    },
    "info.catalog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalog"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログ"
          }
        }
      }
    },
