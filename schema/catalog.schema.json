{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kate941-su.github.io/classicplayer/v1/catalog.schema.json",
  "title": "CMSL Classical Catalog",
  "description": "両アプリとカタログ生成の共通の契約（SPEC §3.2）。schemaVersion 2（1 から: 旧サーバーの http 音源を許可、replacedTracks を追加）。キーはすべて出力する（値がない場合は null）。ID の重複や参照切れはスキーマでは表現できないため validate_catalog.py で検査する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "license", "genres", "composers", "works", "tracks", "replacedTracks"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "$ref": "#/$defs/dateTime" },
    "source": { "const": "https://classical-sound.seesaa.net/" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "credit", "url"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "credit": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "pattern": "^https://" },
        "notes": { "type": "string" }
      }
    },
    "genres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "nameEn", "order", "trackCount"],
        "properties": {
          "id": { "$ref": "#/$defs/slugId" },
          "name": { "$ref": "#/$defs/text" },
          "nameEn": { "$ref": "#/$defs/textOrNull" },
          "order": { "type": "integer", "description": "表示順（昇順）。SPEC §3.3" },
          "trackCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "composers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "nameEn", "trackCount"],
        "properties": {
          "id": { "$ref": "#/$defs/slugId" },
          "name": { "$ref": "#/$defs/text" },
          "nameEn": { "$ref": "#/$defs/textOrNull" },
          "trackCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "works": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "composerId", "genreId"],
        "properties": {
          "id": { "$ref": "#/$defs/slugId" },
          "title": { "$ref": "#/$defs/text" },
          "composerId": { "$ref": "#/$defs/slugId" },
          "genreId": { "$ref": "#/$defs/slugId" }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "titleEn", "composerId", "workId", "genreId", "movement",
          "tags", "audioUrl", "fileName", "articleUrl", "publishedAt", "durationSec"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+(-[0-9]+)?$",
            "description": "記事 ID（1 記事に複数 mp3 なら \"{記事ID}-{連番}\"）。恒久的に変えない。アプリが永続化してよい唯一の ID"
          },
          "title": { "$ref": "#/$defs/text" },
          "titleEn": { "$ref": "#/$defs/textOrNull" },
          "composerId": { "$ref": "#/$defs/slugId" },
          "workId": { "$ref": "#/$defs/slugId" },
          "genreId": { "$ref": "#/$defs/slugId" },
          "movement": { "$ref": "#/$defs/textOrNull" },
          "tags": { "type": "array", "items": { "$ref": "#/$defs/text" } },
          "audioUrl": { "type": "string", "pattern": "^(https://classical-sound\\.up\\.seesaa\\.net|http://(classical-music\\.aki\\.gs|andotowa\\.sakura\\.ne\\.jp|classical-music\\.sakura\\.ne\\.jp))/[^?#]+\\.mp3$", "description": "CMSL（https）か、制作者の旧サーバー（http のみ。SPEC §1.2）" },
          "fileName": { "type": "string", "pattern": "\\.mp3$" },
          "articleUrl": { "type": "string", "pattern": "^https://classical-sound\\.seesaa\\.net/article/[0-9]+\\.html$" },
          "publishedAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
          "durationSec": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "将来拡張。現状は常に null" }
        }
      }
    },
    "replacedTracks": {
      "type": "object",
      "description": "新しい録音に置き換えてカタログから外した曲の ID → 同じ楽章の新しい録音の曲 ID（SPEC §3.2「作品と録音」）。アプリはお気に入り・履歴・キューの ID を読み替える。値は tracks にある ID（連鎖しない）",
      "propertyNames": { "pattern": "^[0-9]+(-[0-9]+)?$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "textOrNull": { "type": ["string", "null"], "minLength": 1 },
    "slugId": { "type": "string", "pattern": "^[^\\s]+$" },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
